# ==============================================================================
# PLASH PILATES STUDIO — PRODUCTION & STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and populate with your verified credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=3333

# Supabase Cloud Database & Authentication
# Hosted PostgreSQL instance reference URL and Public Anonymous Client Key
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_jwt_token_here

# Supabase Service Role Key (Backend Server Only — NEVER expose to frontend client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Razorpay Payment Gateway (Production Merchant Credentials)
# Live credentials format: rzp_live_...
RAZORPAY_KEY_ID=rzp_live_YOUR_MERCHANT_KEY_ID
RAZORPAY_KEY_SECRET=your_razorpay_merchant_secret_here

# Test Mode Override (Only set to true if testing staging orders in production mode)
# ALLOW_TEST_PAYMENTS_IN_PROD=false

# Brevo Transactional Email (Configured inside Supabase Auth SMTP)
# Host: smtp-relay.brevo.com
# Port: 587
# User: websiteplashpilates@gmail.com
# Sender: studio@plashpilates.com
