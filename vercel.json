{
  "functions": {
    "api/server.js": {
      "includeFiles": [
        "index.html",
        "site.webmanifest",
        "css/**",
        "js/**",
        "assets/**",
        "data/**",
        "email-templates/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/server.js"
    }
  ]
}
